# ============================================================
# GEO FITNESS TERRITORY - Backend Environment Variables
# ============================================================

# Server
NODE_ENV=development
PORT=3000
API_VERSION=v1
FRONTEND_URL=http://localhost:8080
MOBILE_APP_URL=exp://localhost:8081

# ============================================================
# DATABASE
# ============================================================
DATABASE_URL=postgresql://geo_user:geo_password@localhost:5432/geo_fitness

# ============================================================
# REDIS
# ============================================================
REDIS_URL=redis://localhost:6379
REDIS_PASSWORD=
REDIS_TTL_DEFAULT=3600

# ============================================================
# JWT
# ============================================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_64_chars
JWT_REFRESH_SECRET=your_super_secret_refresh_key_change_in_production_min_64_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# ============================================================
# FIREBASE (Push Notification)
# ============================================================
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nyour_private_key\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id

# ============================================================
# GAME SETTINGS
# ============================================================
# H3 Resolution (8 = taxminan 460m² cell, 9 = ~100m²)
H3_RESOLUTION=9

# Har 100m yugurish uchun control points
CONTROL_POINTS_PER_100M=10

# Hudud egallash uchun kerakli control points
CAPTURE_THRESHOLD=100

# Bitta cell uchun XP (fog of war kashf qilish)
XP_PER_NEW_CELL=5

# Yugurish uchun XP (har 100m)
XP_PER_100M=2

# Hudud egallash uchun XP
XP_PER_TERRITORY_CAPTURE=50

# ============================================================
# NIGHT EVENT
# ============================================================
NIGHT_EVENT_START_HOUR=20
NIGHT_EVENT_END_HOUR=23
NIGHT_EVENT_MULTIPLIER=1.5

# ============================================================
# CHEAT PROTECTION
# ============================================================
# Maksimal ruxsat etilgan tezlik (km/h)
MAX_ALLOWED_SPEED_KMH=50

# GPS jump uchun maksimal masofa (metr)
MAX_GPS_JUMP_METERS=500

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# FILE UPLOAD
# ============================================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug
LOG_DIR=logs
