# ============================================================
# GAME SETTINGS
# ============================================================
# H3 Resolution (8 = taxminan 460m² cell, 9 = ~100m²)
H3_RESOLUTION=9

# Har 100m yugurish uchun control points
CONTROL_POINTS_PER_100M=10

# Hudud egallash uchun kerakli control points
CAPTURE_THRESHOLD=100

# Bitta cell uchun XP (fog of war kashf qilish)
XP_PER_NEW_CELL=5

# Yugurish uchun XP (har 100m)
XP_PER_100M=2

# Hudud egallash uchun XP
XP_PER_TERRITORY_CAPTURE=50

# ============================================================
# NIGHT EVENT
# ============================================================
NIGHT_EVENT_START_HOUR=20
NIGHT_EVENT_END_HOUR=23
NIGHT_EVENT_MULTIPLIER=1.5

# ============================================================
# CHEAT PROTECTION
# ============================================================
# Maksimal ruxsat etilgan tezlik (km/h)
MAX_ALLOWED_SPEED_KMH=50

# GPS jump uchun maksimal masofa (metr)
MAX_GPS_JUMP_METERS=500

# ============================================================
# RATE LIMITING
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# FILE UPLOAD
# ============================================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# ============================================================
# LOGGING
# ============================================================
LOG_LEVEL=debug
LOG_DIR=logs
