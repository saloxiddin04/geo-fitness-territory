// Geo Fitness Territory - Prisma Schema
// PostgreSQL + PostGIS asosida to'liq database arxitekturasi

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ============================================================
// USERS - Asosiy foydalanuvchilar jadvali
// ============================================================
model User {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username        String   @unique @db.VarChar(50)
  email           String   @unique @db.VarChar(255)
  passwordHash    String   @map("password_hash") @db.VarChar(255)
  displayName     String?  @map("display_name") @db.VarChar(100)
  avatarUrl       String?  @map("avatar_url") @db.VarChar(500)
  
  // O'zbekiston viloyati (reyting uchun)
  region          String?  @db.VarChar(100)
  
  // O'yin statistikasi
  totalXp         Int      @default(0) @map("total_xp")
  level           Int      @default(1)
  
  // Holat
  isActive        Boolean  @default(true) @map("is_active")
  isBlocked       Boolean  @default(false) @map("is_blocked")
  blockedReason   String?  @map("blocked_reason")
  
  // FCM/APNs token (push notification uchun)
  fcmToken        String?  @map("fcm_token") @db.VarChar(500)
  apnsToken       String?  @map("apns_token") @db.VarChar(500)
  
  // Qurilma ma'lumotlari
  devicePlatform  String?  @map("device_platform") @db.VarChar(20) // ios | android
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  lastActiveAt    DateTime? @map("last_active_at")

  // Relations
  refreshTokens     RefreshToken[]
  runningSessions   RunningSession[]
  territories       Territory[]
  exploredCells     UserExploredCell[]
  notifications     Notification[]
  statistics        UserStatistics?
  leaderboardCache  LeaderboardCache[]
  eventLogs         EventLog[]
  sentNotifications Notification[]     @relation("NotificationSender")

  @@index([email])
  @@index([username])
  @@index([region])
  @@index([totalXp])
  @@map("users")
}

// ============================================================
// REFRESH_TOKENS - JWT refresh tokenlar
// ============================================================
model RefreshToken {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  token       String   @unique @db.VarChar(500)
  deviceInfo  String?  @map("device_info") @db.VarChar(255)
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  isRevoked   Boolean  @default(false) @map("is_revoked")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================================
// RUNNING_SESSIONS - Yugurish sessiyalari
// ============================================================
model RunningSession {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  
  // Sessiya holati
  status          SessionStatus @default(ACTIVE)
  
  // Vaqt
  startedAt       DateTime @map("started_at")
  endedAt         DateTime? @map("ended_at")
  durationSeconds Int?     @map("duration_seconds")
  
  // Fitness ma'lumotlari
  distanceMeters  Float    @default(0) @map("distance_meters")
  avgSpeedKmh     Float?   @map("avg_speed_kmh")
  maxSpeedKmh     Float?   @map("max_speed_kmh")
  caloriesBurned  Float?   @map("calories_burned")
  avgPaceMinKm    Float?   @map("avg_pace_min_km")
  
  // O'yin ma'lumotlari
  xpEarned        Int      @default(0) @map("xp_earned")
  territoriesCaptured Int  @default(0) @map("territories_captured")
  cellsExplored   Int      @default(0) @map("cells_explored")
  
  // Night Event bonus
  nightEventBonus Boolean  @default(false) @map("night_event_bonus")
  
  // Xavfsizlik
  isSuspicious    Boolean  @default(false) @map("is_suspicious")
  suspiciousReason String?  @map("suspicious_reason")
  
  // Polyline (kompressiyalangan GPS yo'l)
  routePolyline   String?  @map("route_polyline") @db.Text
  
  // Bounding box (PostGIS)
  boundingBox     Unsupported("geometry(Polygon, 4326)")? @map("bounding_box")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  runningPoints   RunningPoint[]
  eventLogs       EventLog[]

  @@index([userId])
  @@index([status])
  @@index([startedAt])
  @@index([isSuspicious])
  @@map("running_sessions")
}

// ============================================================
// RUNNING_POINTS - GPS nuqtalar (har bir sessiyaning yo'li)
// ============================================================
model RunningPoint {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId   String   @map("session_id") @db.Uuid
  
  // GPS koordinatalar
  latitude    Float    @db.DoublePrecision
  longitude   Float    @db.DoublePrecision
  altitude    Float?   @db.DoublePrecision
  accuracy    Float?   @db.DoublePrecision
  
  // Tezlik
  speedKmh    Float?   @map("speed_kmh")
  
  // Vaqt dampi
  recordedAt  DateTime @map("recorded_at")
  
  // H3 cell index
  h3Index     String   @map("h3_index") @db.VarChar(20)
  
  // PostGIS nuqta
  geomPoint   Unsupported("geometry(Point, 4326)") @map("geom_point")

  session     RunningSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([recordedAt])
  @@index([h3Index])
  @@map("running_points")
}

// ============================================================
// TERRITORIES - Egallangan hududlar (H3 cell asosida)
// ============================================================
model Territory {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  h3Index         String   @unique @map("h3_index") @db.VarChar(20)
  
  // Egasi
  ownerId         String?  @map("owner_id") @db.Uuid
  
  // Hudud ma'lumotlari
  controlPoints   Int      @default(0) @map("control_points")
  defenseLevel    Int      @default(1) @map("defense_level")
  
  // Geolokatsiya
  centerLat       Float    @map("center_lat")
  centerLng       Float    @map("center_lng")
  
  // O'zbekiston viloyati
  region          String?  @db.VarChar(100)
  
  // PostGIS polygon (H3 cell chegaralari)
  geomPolygon     Unsupported("geometry(Polygon, 4326)") @map("geom_polygon")
  
  // Egallangan vaqt
  capturedAt      DateTime? @map("captured_at")
  lastAttackedAt  DateTime? @map("last_attacked_at")
  
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  owner           User?    @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([h3Index])
  @@index([region])
  @@index([controlPoints])
  @@map("territories")
}

// ============================================================
// USER_EXPLORED_CELLS - Fog of War: foydalanuvchi kashf qilgan H3 celllar
// ============================================================
model UserExploredCell {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  h3Index     String   @map("h3_index") @db.VarChar(20)
  
  // Birinchi marta kashf qilingan vaqt
  exploredAt  DateTime @default(now()) @map("explored_at")
  
  // Bu cell uchun XP berilganmi
  xpAwarded   Boolean  @default(false) @map("xp_awarded")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, h3Index])
  @@index([userId])
  @@index([h3Index])
  @@map("user_explored_cells")
}

// ============================================================
// NOTIFICATIONS - Push notifikatsiyalar tarixi
// ============================================================
model Notification {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  senderId    String?  @map("sender_id") @db.Uuid
  
  // Notification turi
  type        NotificationType
  
  // Kontent
  title       String   @db.VarChar(200)
  body        String   @db.Text
  data        Json?    // Extra payload
  
  // Holat
  isRead      Boolean  @default(false) @map("is_read")
  isSent      Boolean  @default(false) @map("is_sent")
  sentAt      DateTime? @map("sent_at")
  readAt      DateTime? @map("read_at")
  
  // FCM/APNs message ID
  fcmMessageId String? @map("fcm_message_id") @db.VarChar(255)
  
  createdAt   DateTime @default(now()) @map("created_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sender      User?    @relation("NotificationSender", fields: [senderId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// USER_STATISTICS - Foydalanuvchi umumiy statistikasi
// ============================================================
model UserStatistics {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId                String   @unique @map("user_id") @db.Uuid
  
  // Yugurish statistikasi
  totalDistanceMeters   Float    @default(0) @map("total_distance_meters")
  totalDurationSeconds  Int      @default(0) @map("total_duration_seconds")
  totalSessions         Int      @default(0) @map("total_sessions")
  totalCaloriesBurned   Float    @default(0) @map("total_calories_burned")
  avgPaceMinKm          Float?   @map("avg_pace_min_km")
  longestRunMeters      Float    @default(0) @map("longest_run_meters")
  fastestSpeedKmh       Float?   @map("fastest_speed_kmh")
  
  // Hudud statistikasi
  totalExploredCells    Int      @default(0) @map("total_explored_cells")
  currentTerritories    Int      @default(0) @map("current_territories")
  totalCaptured         Int      @default(0) @map("total_captured")
  totalLost             Int      @default(0) @map("total_lost")
  totalDefended         Int      @default(0) @map("total_defended")
  
  // Haftalik statistika
  weeklyDistanceMeters  Float    @default(0) @map("weekly_distance_meters")
  weeklyDurationSeconds Int      @default(0) @map("weekly_duration_seconds")
  weeklySessions        Int      @default(0) @map("weekly_sessions")
  weeklyStartDate       DateTime? @map("weekly_start_date")
  
  updatedAt             DateTime @updatedAt @map("updated_at")

  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_statistics")
}

// ============================================================
// LEADERBOARD_CACHE - Redis orqali cache qilinadigan reyting
// ============================================================
model LeaderboardCache {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  
  // Reyting turi
  category    LeaderboardCategory
  
  // Viloyat (regional reyting uchun)
  region      String?  @db.VarChar(100)
  
  // Score
  score       Float    @default(0)
  rank        Int?
  
  // Cache vaqti
  periodType  PeriodType @map("period_type")
  periodStart DateTime   @map("period_start")
  periodEnd   DateTime   @map("period_end")
  
  updatedAt   DateTime @updatedAt @map("updated_at")

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, category, region, periodType, periodStart])
  @@index([category, score])
  @@index([region, category])
  @@map("leaderboard_cache")
}

// ============================================================
// EVENT_LOGS - Tizim loglari va o'yin eventlari
// ============================================================
model EventLog {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String?  @map("user_id") @db.Uuid
  sessionId   String?  @map("session_id") @db.Uuid
  
  eventType   EventType @map("event_type")
  description String?  @db.Text
  metadata    Json?
  
  // Geo ma'lumotlari (agar kerak bo'lsa)
  latitude    Float?   @db.DoublePrecision
  longitude   Float?   @db.DoublePrecision
  h3Index     String?  @map("h3_index") @db.VarChar(20)
  
  ipAddress   String?  @map("ip_address") @db.VarChar(45)
  
  createdAt   DateTime @default(now()) @map("created_at")

  user        User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  session     RunningSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventType])
  @@index([createdAt])
  @@map("event_logs")
}

// ============================================================
// ADMIN_USERS - Admin foydalanuvchilar (alohida jadval)
// ============================================================
model AdminUser {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.VarChar(255)
  displayName  String?  @map("display_name") @db.VarChar(100)
  
  // Admin roli
  role         AdminRole @default(MODERATOR)
  
  isActive     Boolean  @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([email])
  @@map("admin_users")
}

// ============================================================
// SYSTEM_SETTINGS - Tizim sozlamalari (key-value)
// ============================================================
model SystemSetting {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key         String   @unique @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(500)
  
  // Sozlama turi (JSON parsing uchun)
  valueType   String   @default("string") @map("value_type") @db.VarChar(20)
  
  updatedBy   String?  @map("updated_by") @db.VarChar(100)
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

// ============================================================
// ENUMS
// ============================================================

enum SessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  INVALID // Shubhali sessiya

  @@map("session_status")
}

enum NotificationType {
  TERRITORY_ATTACK      // Hududga hujum
  TERRITORY_CAPTURED    // Hudud egallandi
  TERRITORY_DEFENDED    // Hudud himoya qilindi
  NIGHT_EVENT_START     // Kechki event boshlandi
  NIGHT_EVENT_END       // Kechki event tugadi
  NEW_CELL_EXPLORED     // Yangi hudud kashf qilindi
  WEEKLY_STATS          // Haftalik statistika
  RANK_IMPROVED         // Reyting yaxshilandi
  LEVEL_UP              // Daraja oshdi
  SYSTEM               // Tizim xabari
  ADMIN_BROADCAST      // Admin tomonidan yuborilgan

  @@map("notification_type")
}

enum LeaderboardCategory {
  TERRITORY_COUNT       // Eng ko'p hudud
  TOTAL_DISTANCE        // Eng ko'p km
  EXPLORED_CELLS        // Yangi kashfiyotlar
  TOTAL_XP              // Umumiy XP

  @@map("leaderboard_category")
}

enum PeriodType {
  DAILY
  WEEKLY
  MONTHLY
  ALL_TIME

  @@map("period_type")
}

enum EventType {
  // Yugurish
  SESSION_STARTED
  SESSION_ENDED
  SESSION_PAUSED
  SESSION_RESUMED
  
  // Hudud
  TERRITORY_CAPTURED
  TERRITORY_ATTACKED
  TERRITORY_DEFENDED
  TERRITORY_LOST
  CELL_EXPLORED
  
  // O'yin
  NIGHT_EVENT_STARTED
  NIGHT_EVENT_ENDED
  LEVEL_UP
  XP_EARNED
  
  // Xavfsizlik
  SUSPICIOUS_SPEED
  GPS_JUMP_DETECTED
  FAKE_GPS_DETECTED
  
  // Admin
  USER_BLOCKED
  USER_UNBLOCKED
  TERRITORY_RESET
  ADMIN_NOTIFICATION_SENT

  @@map("event_type")
}

enum AdminRole {
  SUPER_ADMIN
  ADMIN
  MODERATOR

  @@map("admin_role")
}
